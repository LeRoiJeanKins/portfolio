$TTL 86400
@   IN  SOA ns.l1-4.ephec-ti.be. admin.l1-4.ephec-ti.be. (
        2026051014 ; Serial 
        3600       ; Refresh
        1800       ; Retry
        604800     ; Expire
        86400 )    ; Minimum TTL

     IN  NS  ns.l1-4.ephec-ti.be.

; --- MAIL ---
@    IN  MX  10 mail.l1-4.ephec-ti.be.

; --- Sécurité Email (SPF & DMARC) ---
; 2.2.2. SPF : Autorise uniquement l'IP du MX à envoyer des mails
@       IN  TXT "v=spf1 mx -all"

; 2.2.4. DMARC : Indique quoi faire en cas d'échec SPF/DKIM (p=none pour observer au début)
_dmarc  IN  TXT "v=DMARC1; p=none; rua=mailto:admin@l1-4.ephec-ti.be;"

; --- Records A ---
@    IN  A   91.134.137.237
ns   IN  A   91.134.137.237
www  IN  A   91.134.137.237
blog IN  A   91.134.137.237
mail IN  A   91.134.137.237

